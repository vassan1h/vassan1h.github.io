---
import { profile } from "../data/profile";
---

<section class="loading-splash">
  <div class="container">
    <p class="eyebrow">{profile.name}</p>
    <h1>
      Building something new
      <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
    </h1>
    <p class="tagline">This site is being rebuilt. Check back soon.</p>
  </div>
</section>

<style>
  .loading-splash {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--color-bg);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: 1.75rem;
    margin: 0 0 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .tagline {
    color: var(--color-text-muted);
  }

  .dots {
    display: inline-flex;
    gap: 0.2rem;
  }

  .dots span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 1.2s ease-in-out infinite;
  }

  .dots span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .dots span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes pulse {
    0%,
    80%,
    100% {
      opacity: 0.2;
      transform: scale(0.8);
    }
    40% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dots span {
      animation: none;
      opacity: 1;
    }
  }
</style>
