---
import { projects } from "../data/projects";
---

<section id="projects" class="section projects">
  <div class="container">
    <h2>Projects</h2>
    <div class="card-grid">
      {
        projects.map((project) => (
          <div class="card">
            <h4>{project.title}</h4>
            <p>{project.description}</p>
            <ul class="tag-list">
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
