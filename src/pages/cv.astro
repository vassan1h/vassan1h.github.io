---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Curriculum Vitae" description="Download or view my full CV.">
  <h1>Curriculum Vitae</h1>
  <p><a href="/assets/data/resume.pdf">Click here to view or download my full CV as a PDF</a></p>
  <iframe
    src="/assets/data/resume.pdf"
    width="100%"
    height="800"
    style="border: 1px solid var(--color-border); border-radius: 8px;"
    title="Vassanth Mathan CV"
  >
    This browser does not support PDFs.
    <a href="/assets/data/resume.pdf">Download the PDF</a> instead.
  </iframe>
</BaseLayout>
